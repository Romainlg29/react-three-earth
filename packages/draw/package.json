{
  "name": "react-three-earth-draw",
  "version": "0.0.0",
  "description": "Headless drawing and editing for react-three-earth: points, lines, polygons and shapes on the globe and the flat map, as GeoJSON",
  "keywords": [
    "react-three-earth",
    "three",
    "react-three-fiber",
    "webgpu",
    "map",
    "draw",
    "geojson",
    "editing",
    "tanstack-intent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Romainlg29/react-three-earth.git",
    "directory": "packages/draw"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/master --passWithNoTests",
    "validate:skills": "intent validate skills"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16",
    "earcut": "^3.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "^0.187.0",
    "happy-dom": "^20.0.0",
    "react": "~19.3.1",
    "react-three-earth": "workspace:*",
    "three": "0.187.0",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.2",
    "vitest": "^5.1.1",
    "@tanstack/intent": "0.5.6",
    "@react-three/fiber": "10.0.0-alpha.6",
    "@types/react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "react": ">=19.0 <19.4",
    "react-three-earth": "workspace:*",
    "three": ">=0.187.0 <0.188.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
