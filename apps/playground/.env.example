# Copy to .env (git-ignored). Defaults are free public services.
VITE_TERRAIN_URL=https://terrain.reearth.land/cesium-mesh/ellipsoid/
VITE_IMAGERY_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Your MapLibre style (vector tiles or PMTiles), shown with ?map=vector. Keep it in .env, never commit it.
VITE_MAP_STYLE_URL=
# Vector tiles in the OpenMapTiles schema (TileJSON) for the gallery examples (?example=city, labels). Default: OpenFreeMap.
VITE_OPENMAPTILES_URL=https://tiles.openfreemap.org/planet
# Terrarium elevation tiles, for ?terrain=dem.
VITE_DEM_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
